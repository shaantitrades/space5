# ── Défaut : LF (compatible Linux/Docker) ────────────────────
* text=auto eol=lf

# ── Scripts shell → toujours LF (obligatoire pour Docker) ────
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# ── Windows scripts → CRLF ────────────────────────────────────
*.bat text eol=crlf
*.ps1 text eol=crlf

# ── Binaires ─────────────────────────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.ttf binary
*.woff binary
*.woff2 binary
