# ============================================================
# .env.production.example — Variables pour déploiement Coolify
# ============================================================
# Copier ce fichier et REMPLIR toutes les valeurs dans
# l'interface Coolify : Service > Environment Variables
# ============================================================

# ── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://multi-convert.com
NEXT_PUBLIC_API_URL=https://multi-convert.com
NEXT_PUBLIC_VERSION=1.0.0
APP_PORT=3000

# ── NEXTAUTH ─────────────────────────────────────────────────
# Générer : openssl rand -base64 32
NEXTAUTH_URL=https://multi-convert.com
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── JWT & CHIFFREMENT ────────────────────────────────────────
# Générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ── BASE DE DONNÉES ──────────────────────────────────────────
# Si PostgreSQL dans le même docker-compose :
DATABASE_URL=postgresql://omniversa:CHANGE_ME_STRONG_PASSWORD@postgres:5432/omniversa
DIRECT_URL=postgresql://omniversa:CHANGE_ME_STRONG_PASSWORD@postgres:5432/omniversa

# Si base externe (Supabase, Neon, RDS, etc.) :
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── POSTGRESQL (service interne) ────────────────────────────
POSTGRES_USER=omniversa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=omniversa

# ── REDIS ────────────────────────────────────────────────────
# Si Redis dans le même docker-compose :
REDIS_URL=redis://redis:6379

# ── GOOGLE OAUTH ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxx

# ── STRIPE ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ── EMAIL ────────────────────────────────────────────────────
# Resend (recommandé) : clé API + domaine d'EMAIL_FROM vérifié dans le compte
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Repli : SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxx

# ── AWS S3 (optionnel) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=eu-west-1
S3_BUCKET=multi-convert-prod-files

# ── ADMIN ────────────────────────────────────────────────────
ADMIN_EMAILS=admin@votre-domaine.com

# ── GOOGLE ADSENSE (monétisation) ────────────────────────────
# Runbook : docs/ADSENSE.md
# Sans ces variables (ou avec ENABLED=false), le site ne contacte jamais Google.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5343389597650456
# CMP Google (Funding Choices) — obligatoire pour diffuser dans l'EEE/UK/CH
# NEXT_PUBLIC_ADSENSE_CMP_ID=pub-5343389597650456
NEXT_PUBLIC_ADSENSE_REQUIRE_CONSENT=true
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ── BUILD / MÉMOIRE (VPS, build time) ────────────────────────
# Le build sur le VPS échouait sur « Collecting build traces ... »
# (exit 255, aucun message) : mémoire insuffisante. Ces variables sont lues
# AU BUILD (pas au démarrage) — les définir dans Coolify > Environment
# Variables avec la portée « build time » :
#   NEXT_BUILD_WORKERS=1            # 1 worker de build (défaut du VPS)
#   NODE_MAX_OLD_SPACE_SIZE=2048    # plafond du tas Node du build (Mo)
# Laisser vide = dimensionnement automatique (voir next.config.js).
# NEXT_BUILD_WORKERS=
# NODE_MAX_OLD_SPACE_SIZE=1536

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://votre-domaine.com

# ── SENTRY (optionnel) ───────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
