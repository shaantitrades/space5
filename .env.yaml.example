# Variables d'environnement pour Firebase App Hosting
# Ces variables sont injectées lors du build et au runtime

# === VARIABLES DE BUILD (disponibles pendant npm run build) ===
# Ces variables sont nécessaires pour la compilation

NODE_ENV: production
DEV_MODE: "false"
SKIP_DB: "true"

# === VARIABLES OPTIONNELLES ===
# Décommentez et configurez selon vos besoins

# Base de données (si vous utilisez RDS/Supabase)
# DATABASE_URL: "postgresql://user:password@host:5432/database"

# NextAuth (authentification)
# NEXTAUTH_SECRET: "your-secret-key-here"
# NEXTAUTH_URL: "https://your-app.web.app"

# Stripe (paiements)
# STRIPE_SECRET_KEY: "sk_live_..."
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY: "pk_live_..."

# UploadThing (upload de fichiers)
# UPLOADTHING_SECRET: "sk_live_..."
# UPLOADTHING_APP_ID: "your-app-id"

# Redis (cache/rate limiting)
# REDIS_URL: "redis://default:password@host:6379"

# Email (notifications)
# EMAIL_SERVER: "smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM: "noreply@example.com"

# === NOTES IMPORTANTES ===
# 1. Ne commitez JAMAIS ce fichier avec des vraies valeurs
# 2. Les variables avec NEXT_PUBLIC_ sont exposées côté client
# 3. Configurez les secrets via Firebase Console pour la production
# 4. Pour le développement local, utilisez .env.local
