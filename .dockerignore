# ── Node ──────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Next.js ───────────────────────────────────────────────────
.next
out
build
dist

# ── Git ───────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Env / secrets ─────────────────────────────────────────────
# Toutes les variantes sont exclues : les variables d'environnement sont
# injectees par Coolify a l'execution, le conteneur n'a pas besoin de ces
# fichiers (et .env.prod ne doit surtout pas se retrouver dans une couche
# de l'image Docker).
.env
.env.*
*.env

# ── Docs & scripts locaux ─────────────────────────────────────
*.md
docs/
scripts/
*.ps1
*.sh
*.bat
!docker-entrypoint.sh

# ── CI / scripts locaux ───────────────────────────────────────
.github/
deploy-*.ps1
deploy-*.sh
setup-*.*
configure-*.*

# ── Outils de dev ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.pem
*.log
*.tsbuildinfo

# ── Tests ─────────────────────────────────────────────────────
coverage/
__tests__/
*.test.ts
*.spec.ts

# ── Divers ────────────────────────────────────────────────────
uploads/
temp/
diagnose.js
test-routes.js
_*.js
docker-compose.yml
docker-compose.coolify.yml
Dockerfile.dev
causing*
