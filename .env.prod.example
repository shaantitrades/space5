# Exemple `.env` pour déploiement production (NE CONTIENT PAS DE SECRETS)
# Copiez ce fichier en `.env.prod` puis remplissez les valeurs sensibles via votre système de secrets.

# App
NEXT_PUBLIC_APP_URL=https://your-app.example
NEXT_PUBLIC_API_URL=https://your-app.example
NEXT_PUBLIC_VERSION=1.0.0

# Auth / app secrets
NEXTAUTH_URL=https://your-app.example
NEXTAUTH_SECRET=change_me
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/multi_convert
DIRECT_URL=postgresql://postgres:password@postgres:5432/multi_convert
POSTGRES_PASSWORD=MultiConvert2026
POSTGRES_DB=multi_convert

# Redis
REDIS_URL=redis://redis:6379

# External services (replace with your keys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET=
