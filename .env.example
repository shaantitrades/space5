# ========== BASE DE DONNÉES ==========
DATABASE_URL=postgresql://multi_convert:password@localhost:5432/multi_convert
DIRECT_URL=postgresql://multi_convert:password@localhost:5432/multi_convert

# ========== CACHE & QUEUES ==========
REDIS_URL=redis://localhost:6379

# ========== AUTHENTIFICATION ==========
NEXTAUTH_SECRET=your-256bit-secret-here-change-this
JWT_SECRET=your-256bit-jwt-secret-here-change-this
GOOGLE_CLIENT_ID=123456789.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx

# ========== CHIFFREMENT ==========
ENCRYPTION_KEY=your-256bit-encryption-key-hex-here

# ========== EMAIL ==========
# --- Resend (recommandé : une seule variable suffit) ---
RESEND_API_KEY=re_xxxxxxxxxxxxx

# --- Repli : SendGrid ou SMTP générique ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxx

# Expéditeur des emails applicatifs (doit être un domaine vérifié chez le fournisseur)
EMAIL_FROM=noreply@multi-convert.com
# Adresse publique affichée sur le site
CONTACT_EMAIL=contact@multi-convert.com
# Destinataire des demandes entreprise (laisser vide pour utiliser ADMIN_EMAILS)
LEADS_NOTIFICATION_EMAIL=

# ========== STRIPE (OPTIONNEL) ==========
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx

# ========== AWS (OPTIONNEL) ==========
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=eu-west-1
S3_BUCKET=multi-convert-prod-files

# ========== SENTRY (OPTIONNEL) ==========
SENTRY_DSN=https://xxx@sentry.io/xxx

# ========== ADMIN ==========
ADMIN_EMAILS=admin@multi-convert.com,security@multi-convert.com

# ========== APP CONFIG ==========
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_VERSION=1.0.0
NODE_ENV=development

# ========== GOOGLE ADSENSE (OPTIONNEL — monétisation) ==========
# Documentation complète : docs/ADSENSE.md
# Laisser tel quel (enabled absent/false) = aucune requête vers Google.
# Valeurs inlinées AU BUILD → redéployer après modification.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Identifiant éditeur (défaut embarqué : ca-pub-5343389597650456)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5343389597650456
# CMP Google Funding Choices — OBLIGATOIRE pour monétiser l'EEE/UK/CH
# NEXT_PUBLIC_ADSENSE_CMP_ID=pub-5343389597650456
# false uniquement si la CMP Google gère le consentement à la place de la bannière interne
NEXT_PUBLIC_ADSENSE_REQUIRE_CONSENT=true
# IDs des blocs créés dans AdSense > Annonces > Par bloc d'annonces
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ========== CORS ==========
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
